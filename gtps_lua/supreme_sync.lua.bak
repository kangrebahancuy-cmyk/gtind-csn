    table.insert(d, "end_dialog|supreme_link_dialog|Batal|Link Sekarang|\n")

    player:sendDialog(table.concat(d))
end

-- ============================================================
-- COMMAND PROCESSOR
-- ============================================================
local function handleCommand(player, cmd, arg)
    local growid = player:getName()
    cmd = string.lower(cmd or "")
    arg = arg or ""

    -- /casino or /supreme
    if cmd == "casino" or cmd == "supreme" then
        showCasinoDialog(player)
        return true
    end

    -- /casinohelp
    if cmd == "casinohelp" then
        player:sendConsoleMessage("`6===== [ SUPREME CASINO ] =====``")
        player:sendConsoleMessage("`2/casino `w- Buka panel casino``")
        player:sendConsoleMessage("`2/deposit <jml> [wl|dl|bgl] `w- Deposit ke casino``")
        player:sendConsoleMessage("`2/withdraw <jml> [wl|dl|bgl] `w- Withdraw ke backpack``")
        player:sendConsoleMessage("`2/link <kode> `w- Link akun web casino``")
        player:sendConsoleMessage("`2/balance `w- Cek saldo casino``")
        player:sendConsoleMessage("`6================================``")
        return true
    end

    -- /link [kode]
    if cmd == "link" or cmd == "setgrowid" then
        local code = arg:match("(%d%d%d%d%d%d?)")
        if not code or code == "" then
            showLinkDialog(player)
            return true
        end
        checkAndApplyCode(player, code)
        return true
    end

    -- /balance or /bal
    if cmd == "balance" or cmd == "bal" then
        local linkedUser = getLinkedUsername(growid)
        if not linkedUser then
            player:sendConsoleMessage("`4[SUPREME] Kamu belum link akun! Ketik `6/link <kode>`4 dulu.``")
            return true
        end
        local bal = getBalance(linkedUser)
        player:sendConsoleMessage("`2[SUPREME] GrowID: `6" .. growid .. " `w| Akun: `6" .. linkedUser .. " `w| Saldo: `2" .. math.floor(bal) .. " DLS `w(`2" .. string.format("%.2f", bal / 100) .. " BGL`w)``")
        return true
    end

    -- /deposit <amount> [wl|dl|bgl]
    if cmd == "deposit" or cmd == "dep" then
        local amtStr, curStr = arg:match("^(%d+)%s*(%a*)$")
        local amt = tonumber(amtStr) or 0
        curStr = string.lower(curStr or "dl")
        if curStr == "" then curStr = "dl" end

        if amt <= 0 then
            player:sendConsoleMessage("`4[SUPREME] Contoh: `6/deposit 50 dl`4 atau `6/deposit 1 bgl``")
            return true
        end

        local linkedUser = getLinkedUsername(growid)
        if not linkedUser then
            player:sendConsoleMessage("`4[SUPREME] Kamu belum link akun casino! Ketik `6/link <kode>``")
            return true
        end

        local itemId, currencyName, dlsValue
        if curStr == "bgl" then
            itemId = ITEM_BGL; currencyName = "BGL"; dlsValue = amt * 100
        elseif curStr == "wl" then
            itemId = ITEM_WL;  currencyName = "WL";  dlsValue = amt / 100
        else
            itemId = ITEM_DL;  currencyName = "DL";  dlsValue = amt
        end

        local currentInInv = player:getInventoryItemCount(itemId)
        if currentInInv < amt then
            player:sendConsoleMessage("`4[SUPREME] Item tidak cukup! Kamu punya " .. currentInInv .. " " .. currencyName .. ", butuh " .. amt .. "``")
            return true
        end

        -- Kurangi item dari inventory
        player:removeItem(itemId, amt)

        -- Tambah saldo casino
        local currentBal = getBalance(linkedUser)
        local newBal = currentBal + dlsValue
        setBalance(linkedUser, newBal)

        player:sendConsoleMessage("`2[SUPREME] Berhasil deposit `2" .. amt .. " " .. currencyName .. "`2! Saldo baru: `6" .. math.floor(newBal) .. " DLS``")

        -- Kirim webhook ke website
        webhookDeposit(growid, currencyName, amt)
        return true
    end

    -- /withdraw <amount> [wl|dl|bgl]
    if cmd == "withdraw" or cmd == "wd" or cmd == "with" then
        local amtStr, curStr = arg:match("^(%d+)%s*(%a*)$")
        local amt = tonumber(amtStr) or 0
        curStr = string.lower(curStr or "dl")
        if curStr == "" then curStr = "dl" end

        if amt <= 0 then
            player:sendConsoleMessage("`4[SUPREME] Contoh: `6/withdraw 10 dl`4 atau `6/withdraw 1 bgl``")
            return true
        end

        local linkedUser = getLinkedUsername(growid)
        if not linkedUser then
            player:sendConsoleMessage("`4[SUPREME] Kamu belum link akun casino! Ketik `6/link <kode>``")
            return true
        end

        local itemId, currencyName, dlsCost
        if curStr == "bgl" then
            itemId = ITEM_BGL; currencyName = "BGL"; dlsCost = amt * 100
        elseif curStr == "wl" then
            itemId = ITEM_WL;  currencyName = "WL";  dlsCost = amt / 100
        else
            itemId = ITEM_DL;  currencyName = "DL";  dlsCost = amt
        end

        local currentBal = getBalance(linkedUser)
        if currentBal < dlsCost then
            player:sendConsoleMessage("`4[SUPREME] Saldo tidak cukup! Saldo: `4" .. math.floor(currentBal) .. " DLS`4, butuh: `4" .. math.floor(dlsCost) .. " DLS``")
            return true
        end

        -- Kurangi saldo casino
        setBalance(linkedUser, currentBal - dlsCost)

        -- Beri item ke player
        player:giveItem(itemId, amt)

        player:sendConsoleMessage("`2[SUPREME] Berhasil withdraw `2" .. amt .. " " .. currencyName .. "`2! Sudah masuk backpack. Sisa: `6" .. math.floor(currentBal - dlsCost) .. " DLS``")

        -- Kirim webhook ke website
        webhookWithdraw(growid, currencyName, amt)
        return true
    end

    return false
end

-- ============================================================
-- CALLBACK: onPlayerCommandCallback
-- Dipanggil saat player mengetik /perintah di game
-- ============================================================
onPlayerCommandCallback(function(world, player, command, args)
    -- gtps.cloud: command = string perintah (tanpa /), args = argumen
    local cmd = string.lower(tostring(command or ""))
    local arg = tostring(args or "")
    return handleCommand(player, cmd, arg)
end)

-- ============================================================
-- CALLBACK: onPlayerDialogCallback
-- Dipanggil saat player submit dialog
-- ============================================================
onPlayerDialogCallback(function(world, player, dialogName, buttonClicked, data)
    local dName = tostring(dialogName or "")
    local btn   = tostring(buttonClicked or "")

    -- Dialog: Input kode link
    if dName == "supreme_link_dialog" then
        if btn == "Batal" or btn == "" then return true end
        local code = ""
        if type(data) == "table" then
            code = tostring(data.inp_link_code or data["inp_link_code"] or "")
        end
        code = string.gsub(code, "%s+", "")
        if code ~= "" then
            checkAndApplyCode(player, code)
        else
            player:sendConsoleMessage("`4[SUPREME] Kode tidak boleh kosong!``")
        end
        return true
    end

    -- Dialog: Menu casino
    if dName == "supreme_casino_menu" then
        if btn == "btn_link" then
            showLinkDialog(player)
        end
        return true
    end

    return false
end)

-- ============================================================
-- REGISTER COMMANDS ke gtps.cloud
-- ============================================================
registerCommand("casino",     "Buka panel Supreme Casino")
registerCommand("supreme",    "Buka panel Supreme Casino")
registerCommand("casinohelp", "Bantuan perintah casino")
registerCommand("deposit",    "Deposit ke casino: /deposit <jml> [wl|dl|bgl]")
registerCommand("dep",        "Deposit ke casino: /dep <jml> [wl|dl|bgl]")
registerCommand("withdraw",   "Withdraw dari casino: /withdraw <jml> [wl|dl|bgl]")
registerCommand("wd",         "Withdraw dari casino: /wd <jml> [wl|dl|bgl]")
registerCommand("with",       "Withdraw dari casino: /with <jml> [wl|dl|bgl]")
registerCommand("link",       "Link akun casino: /link <kode 6 digit>")
registerCommand("balance",    "Cek saldo casino")
registerCommand("bal",        "Cek saldo casino")

print("[SUPREME CASINO] Script loaded! Siap digunakan di gtps.cloud")
print("[SUPREME CASINO] Website API: " .. WEB_API_URL)
