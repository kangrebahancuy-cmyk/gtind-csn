-- ============================================================
-- SUPREME CASINO - GTPS.CLOUD SYNC ENGINE v2.0
-- Compatible with: gtps.cloud Lua API (dash.gtps.cloud/docs)
-- HTTP API: http:get(url, headers) / http:post(url, headers, postData)
-- ============================================================

-- ============================================================
-- KONFIGURASI - GANTI DENGAN NILAI KAMU
-- ============================================================
local WEB_API_URL  = "https://YOUR-CASINO-WEBSITE.onrender.com/api"  -- URL publik website casino kamu
local SECRET_KEY   = "supreme_gtps_secret_auth_token_25741"           -- Harus sama dengan server.js

local ITEM_WL  = 242
local ITEM_DL  = 1796
local ITEM_BGL = 7188

-- ============================================================
-- DATABASE SQLite (Persistent - tidak hilang saat server restart)
-- ============================================================
local db = sqlite:open("supreme_casino.db")

db:exec([[
    CREATE TABLE IF NOT EXISTS accounts (
        username TEXT PRIMARY KEY,
        balance  REAL DEFAULT 0
    );
    CREATE TABLE IF NOT EXISTS links (
        growid   TEXT PRIMARY KEY,
        username TEXT NOT NULL
    );
]])

-- ============================================================
-- DB HELPERS
-- ============================================================
local function getBalance(username)
    local rows = db:query("SELECT balance FROM accounts WHERE username = ?", { username })
    if rows and rows[1] then return tonumber(rows[1].balance) or 0 end
    return 0
end

local function setBalance(username, amount)
    amount = math.max(0, amount)
    db:exec("INSERT OR REPLACE INTO accounts (username, balance) VALUES (?, ?)", { username, amount })
end

local function getLinkedUsername(growid)
    local rows = db:query("SELECT username FROM links WHERE growid = ?", { string.lower(growid) })
    if rows and rows[1] then return rows[1].username end
    return nil
end

local function setLink(growid, username)
    db:exec("INSERT OR REPLACE INTO links (growid, username) VALUES (?, ?)", { string.lower(growid), string.lower(username) })
end

-- ============================================================
-- HTTP HELPERS (gtps.cloud API: http:get / http:post)
-- Semua HTTP call WAJIB di dalam coroutine
-- ============================================================
local JSON_HEADERS = { ["Content-Type"] = "application/json" }

local function asyncPost(url, payload)
    coroutine.wrap(function()
        local ok, err = pcall(function()
            http:post(url, JSON_HEADERS, tostring(payload or "{}"))
        end)
        if not ok then
            print("[SUPREME] HTTP POST error: " .. tostring(err))
        end
    end)()
end

local function asyncGet(url, callback)
    coroutine.wrap(function()
        local ok, result = pcall(function()
            return http:get(url, JSON_HEADERS)
        end)
        if ok and result and callback then
            callback(result)
        end
    end)()
end

-- ============================================================
-- SEND WEBHOOK ke website casino
-- ============================================================
local function webhookDeposit(growid, currency, amount)
    local payload = string.format(
        '{"growId":"%s","currency":"%s","amount":%d,"secretKey":"%s"}',
        growid, currency, amount, SECRET_KEY
    )
    asyncPost(WEB_API_URL .. "/gtps/deposit-webhook", payload)
end

local function webhookWithdraw(growid, currency, amount)
    local payload = string.format(
        '{"growId":"%s","currency":"%s","amount":%d,"secretKey":"%s"}',
        growid, currency, amount, SECRET_KEY
    )
    asyncPost(WEB_API_URL .. "/gtps/withdraw-webhook", payload)
end

local function webhookLink(growid, code, username)
    local payload = string.format(
        '{"growid":"%s","code":"%s","username":"%s"}',
        growid, code, username
    )
    asyncPost(WEB_API_URL .. "/gtps/link-growid", payload)
end

-- ============================================================
-- CHECK LINK CODE dari website (polling saat player ketik /link)
-- ============================================================
local function checkAndApplyCode(player, code)
    local growid = player:getName()
    local cleanCode = string.gsub(tostring(code or ""), "%s+", "")
    if cleanCode == "" then
        player:sendConsoleMessage("`4[SUPREME] Masukkan kode 6 digit dari website casino!``")
        return
    end

    asyncGet(WEB_API_URL .. "/gtps/check-link?code=" .. cleanCode, function(response)
        -- Response: {"linked":true,"growId":"xxx","code":"123456"}
        -- atau website belum link: {"linked":false}
        -- Kita lakukan linking dari sisi Lua dulu,
        -- lalu kirim webhook ke website
        local username = string.lower(cleanCode) -- fallback sementara pakai kode sebagai username

        -- Coba parse JSON response sederhana
        if response and type(response) == "table" and response.body then
            local body = tostring(response.body)
            local linkedUsername = body:match('"username"%s*:%s*"([^"]+)"')
            if linkedUsername and linkedUsername ~= "" then
                username = string.lower(linkedUsername)
            end
        end

        -- Simpan link ke DB
        setLink(growid, username)

        -- Buat akun jika belum ada
        if getBalance(username) == 0 then
            setBalance(username, 0)
        end

        -- Kirim webhook ke website
        webhookLink(growid, cleanCode, username)

        -- Notif ke player
        player:sendConsoleMessage("`2[SUPREME] Berhasil! GrowID `6" .. growid .. "`2 terhubung ke akun casino!``")
        player:sendConsoleMessage("`2[SUPREME] Ketik `6/balance`2 untuk cek saldo, `6/deposit`2 untuk deposit!``")
    end)
end

