# Phase 1 Economy
GTPS_WEBHOOK_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# GTPS bridge port used by the existing Lua bridge
GTPS_PORT=18876

# MongoDB Atlas production storage
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=gtind_csn
MONGODB_MAX_POOL_SIZE=50
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
